{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "ppclv",
  "compatibility_date": "2026-08-11",
  "main": "worker/index.mjs",
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "run_worker_first": [
      "/contact-request"
    ]
  },
  "send_email": [
    {
      "name": "PPC_CONTACT_EMAIL",
      "destination_address": "Adria@ProfessionalPoolCare.com",
      "allowed_sender_addresses": [
        "Adria@ProfessionalPoolCare.com"
      ]
    }
  ]
}
